FROM python:3.12-slim AS runtime
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
RUN groupadd --gid 10001 opspilot && useradd --uid 10001 --gid opspilot --create-home opspilot
WORKDIR /app
COPY backend/pyproject.toml /app/backend/pyproject.toml
COPY backend/src /app/backend/src
COPY backend/alembic /app/backend/alembic
COPY backend/alembic.ini /app/backend/alembic.ini
COPY demo-services /app/demo-services
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --retries 10 --timeout 60 /app/backend \
    && chown -R opspilot:opspilot /app \
    && install -d -o opspilot -g opspilot -m 0750 /app/data/documents
USER opspilot
WORKDIR /app/backend
CMD ["uvicorn", "opspilot.main:app", "--host", "0.0.0.0", "--port", "8000"]
